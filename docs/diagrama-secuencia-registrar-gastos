@startuml
title DS-11 - Registrar gastos y presupuesto

actor Administrador
boundary "Interfaz web" as UI
participant "js/api.js" as APIJS
control "Express" as Express
participant "Controlador de gastos propuesto" as Controlador
database "Gasto.js / MongoDB" as BD

Administrador -> UI : Registrar gasto de reparacion
UI -> APIJS : Enviar concepto, valor y fecha
APIJS -> Express : Solicitud de registro de gasto
Express -> Controlador : Procesar gasto
Controlador -> Controlador : Validar datos

alt Datos validos
    Controlador -> BD : Guardar gasto
    BD --> Controlador : Gasto registrado
    Controlador --> APIJS : Confirmacion
else Datos invalidos
    Controlador --> APIJS : Errores de validacion
end

APIJS --> UI : Mostrar resultado
UI --> Administrador : Confirmar registro

opt Definir presupuesto anual
    note over Administrador, BD
      El grupo debe definir donde guardar
      y como actualizar el presupuesto anual.
    end note
end

@enduml
