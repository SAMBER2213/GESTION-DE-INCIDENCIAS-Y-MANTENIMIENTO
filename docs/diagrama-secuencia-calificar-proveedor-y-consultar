@startuml
title DS-08 - Calificar proveedor y consultar historial

actor Administrador
boundary "paginas/proveedores.html" as UI
participant "js/api.js" as APIJS
control "Express" as Express
participant "proveedorRutas.js" as Rutas
participant "proveedorControlador.js" as Controlador
database "Proveedor.js / MongoDB" as Proveedores
database "OrdenServicio.js / MongoDB" as Ordenes

Administrador -> UI : Abrir proveedor
UI -> APIJS : Solicitar historial y calificacion
APIJS -> Express : Solicitud de consulta
Express -> Rutas : Enrutar solicitud
Rutas -> Controlador : Consultar historial
Controlador -> Proveedores : Buscar datos del proveedor
Proveedores --> Controlador : Datos del proveedor
Controlador -> Ordenes : Consultar ordenes relacionadas
Ordenes --> Controlador : Historial de ordenes
Controlador --> APIJS : Datos e historial
APIJS --> UI : Mostrar informacion
UI --> Administrador : Ver historial y calificaciones

opt Calificar proveedor
    Administrador -> UI : Registrar calificacion
    UI -> APIJS : Enviar puntuacion y observaciones
    APIJS -> Express : Solicitud de calificacion
    Express -> Rutas : Enrutar solicitud
    Rutas -> Controlador : Guardar calificacion
    Controlador -> Proveedores : Actualizar calificacion
    Proveedores --> Controlador : Confirmacion
    Controlador --> APIJS : Resultado
    APIJS --> UI : Mostrar confirmacion
end

@enduml
